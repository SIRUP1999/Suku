DEBUG=true
SECRET_KEY=development-only-change-this-to-a-unique-random-value-before-deploying
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
CACHE_URL=
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000/api
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Production: set DEBUG=false and use a random SECRET_KEY of at least 50 characters.
# Optional: set GEMINI_API_KEY on the backend to enable student PDF work checking.
# HTTPS defaults are enabled when DEBUG=false; only enable proxy trust behind a trusted HTTPS load balancer.
# USE_X_FORWARDED_PROTO=false
